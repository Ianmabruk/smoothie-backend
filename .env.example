# ---------------------------------------------------------------------------
# Smoothie AI backend environment variables (server side only - never committed)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Core application secrets (server side only - never exposed to the frontend)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production-jwt
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL only; local SQLite is intentionally not used)
# ---------------------------------------------------------------------------
# Example: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
AUTO_CREATE_TABLES=False

DEBUG=False
HOST=0.0.0.0
PORT=5000

# ---------------------------------------------------------------------------
# CORS (comma separated list of allowed browser origins)
# ---------------------------------------------------------------------------
# Set this to the exact origin of the deployed frontend, e.g.
#   https://my-site.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=True
CORS_MAX_AGE_SECONDS=600

# ---------------------------------------------------------------------------
# Reverse proxy / TLS
# ---------------------------------------------------------------------------
TRUST_PROXY=True

# ---------------------------------------------------------------------------
# NVIDIA NIM configuration (server side only)
# ---------------------------------------------------------------------------
# Obtain an API key from https://build.nvidia.com/ and choose a model available
# to your account from the NVIDIA API catalog.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_actual_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_verified_supported_model

# Compatibility aliases accepted by the backend.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# ---------------------------------------------------------------------------
# AI request behaviour
# ---------------------------------------------------------------------------
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=2

# ---------------------------------------------------------------------------
# Safety limits
# ---------------------------------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_CONTEXT_MESSAGES=12

# Legacy provider settings are intentionally disabled. Smoothie AI routes all
# chat through NVIDIA NIM only. No Gemini, Groq, OpenRouter, Ollama, or mock
# answer path is used.
